          "instant": true,
          "legendFormat": "",
          "refId": "B"
        },
        {
          "expr": "sum(increase(fgw_deals_completed_total[30d])) by (provider)",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "refId": "C"
        }
      ],
      "title": "Provider Cost Analysis (30 days)",
      "transformations": [
        {
          "id": "seriesToColumns",
          "options": { "byField": "provider" }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time 1": true, "Time 2": true, "Time 3": true },
            "indexByName": {},
            "renameByName": {
              "Value #A": "Avg Cost",
              "Value #B": "Total Cost",
              "Value #C": "Deal Count",
              "provider": "Provider"
            }
          }
        }
