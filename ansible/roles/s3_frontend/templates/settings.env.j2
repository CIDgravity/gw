# {{ ansible_managed }}
# S3 Frontend Proxy settings for {{ fgw_node_id }}
# Generated: {{ ansible_date_time.iso8601 }}

# =============================================================================
# Node Identification
# =============================================================================
FGW_NODE_ID="{{ fgw_node_id }}"
FGW_NODE_TYPE="{{ fgw_node_type }}"

# =============================================================================
# Backend Nodes (Kuri storage nodes)
# Format: node_id:url,node_id:url,...
# =============================================================================
{% set backend_list = [] %}
{% for host in groups['kuri'] %}
{% set node_id = hostvars[host]['fgw_node_id'] %}
{% set node_host = hostvars[host]['ansible_host'] %}
{% set node_port = hostvars[host].get('kuri_s3_port', 8079) %}
{% set _ = backend_list.append(node_id ~ ':http://' ~ node_host ~ ':' ~ node_port) %}
{% endfor %}
FGW_BACKEND_NODES="{{ backend_list | join(',') }}"

# =============================================================================
# YCQL for Object Routing (shared keyspace)
# =============================================================================
FGW_YCQL_HOSTS="{{ fgw_ycql_hosts }}"
FGW_YCQL_PORT="{{ fgw_ycql_port }}"
FGW_YCQL_KEYSPACE="{{ fgw_ycql_keyspace }}"
{% if yb_ycql_user is defined and yb_ycql_user | length > 0 %}
FGW_YCQL_USER="{{ yb_ycql_user }}"
FGW_YCQL_PASS="{{ yb_ycql_pass }}"
{% endif %}

# =============================================================================
# S3 API Binding
# =============================================================================
RIBS_S3API_BINDADDR=":{{ s3_frontend_port }}"
RIBS_S3API_REGION="{{ ribs_s3api_region }}"
RIBS_S3API_AUTH_ENABLED="{{ ribs_s3api_auth_enabled }}"
{% if ribs_s3api_root_access_key_id is defined and ribs_s3api_root_access_key_id | length > 0 %}
RIBS_S3API_ROOT_ACCESS_KEY_ID="{{ ribs_s3api_root_access_key_id }}"
RIBS_S3API_ROOT_SECRET_KEY="{{ ribs_s3api_root_secret_key }}"
{% endif %}

# =============================================================================
# Internal API
# =============================================================================
FGW_INTERNAL_API_BINDADDR=":{{ s3_frontend_internal_api_port }}"

# =============================================================================
# Prometheus Metrics
# =============================================================================
RIBS_PROMETHEUS_PORT="{{ ribs_prometheus_port }}"

# =============================================================================
# Logging
# =============================================================================
RIBS_LOGLEVEL="{{ ribs_loglevel }}"
