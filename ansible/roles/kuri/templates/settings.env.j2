# {{ ansible_managed }}
# Kuri settings for {{ fgw_node_id }}
# Generated: {{ ansible_date_time.iso8601 }}

# =============================================================================
# Node Identification
# =============================================================================
FGW_NODE_ID="{{ fgw_node_id }}"
FGW_NODE_TYPE="{{ fgw_node_type }}"

# =============================================================================
# RIBS Data
# =============================================================================
RIBS_DATA="{{ ribs_data }}"
RIBS_MAX_LOCAL_GROUP_COUNT="{{ ribs_max_local_group_count }}"
{% if ribs_max_staging_group_count is defined and ribs_max_staging_group_count > 0 %}
RIBS_MAX_STAGING_GROUP_COUNT="{{ ribs_max_staging_group_count }}"
{% endif %}

# =============================================================================
# Filecoin API
# =============================================================================
RIBS_FILECOIN_API_ENDPOINT="{{ ribs_filecoin_api_endpoint }}"

# =============================================================================
# CIDGravity
# =============================================================================
CIDGRAVITY_API_TOKEN="{{ cidgravity_api_token }}"
CIDGRAVITY_API_ENDPOINT_GBAP="{{ cidgravity_api_endpoint_gbap }}"
CIDGRAVITY_API_ENDPOINT_GOCD="{{ cidgravity_api_endpoint_gocd }}"
CIDGRAVITY_MAX_CONNECTIONS="{{ cidgravity_max_connections }}"

# =============================================================================
# Deal Settings
# =============================================================================
RIBS_MINIMUM_REPLICA_COUNT="{{ ribs_minimum_replica_count }}"
RIBS_MAXIMUM_REPLICA_COUNT="{{ ribs_maximum_replica_count }}"
RIBS_MINIMUM_RETRIEVABLE_COUNT="{{ ribs_minimum_retrievable_count }}"
RIBS_RETRIEVALBLE_REPAIR_THRESHOLD="{{ ribs_retrievable_repair_threshold }}"
RIBS_DEAL_START_TIME="{{ ribs_deal_start_time }}"
RIBS_DEAL_DURATION="{{ ribs_deal_duration }}"
RIBS_DEAL_REMOVE_UNSEALED="{{ ribs_deal_remove_unsealed }}"
RIBS_DEAL_SKIP_IPNI_ANNOUNCE="{{ ribs_deal_skip_ipni_announce }}"
RIBS_DEAL_CHECK_INTERVAL="{{ ribs_deal_check_interval }}"
RIBS_RUN_SP_CRAWLER="{{ ribs_run_sp_crawler }}"
{% if ribs_deal_fallback_providers is defined and ribs_deal_fallback_providers | length > 0 %}
RIBS_DEAL_FALLBACK_PROVIDERS="{{ ribs_deal_fallback_providers }}"
{% endif %}
{% if ribs_deal_fallback_providers_only is defined %}
RIBS_DEAL_FALLBACK_PROVIDERS_ONLY="{{ ribs_deal_fallback_providers_only }}"
{% endif %}

# =============================================================================
# YugabyteDB - Per-node (RIBS data)
# =============================================================================
RIBS_YUGABYTE_SQL_HOST="{{ yb_ysql_host }}"
RIBS_YUGABYTE_SQL_PORT="{{ yb_ysql_port }}"
RIBS_YUGABYTE_SQL_DB="filecoingw_{{ fgw_node_id | replace('-', '_') }}"
RIBS_YUGABYTE_SQL_USER="{{ yb_ysql_user }}"
RIBS_YUGABYTE_SQL_PASS="{{ yb_ysql_pass }}"

RIBS_YUGABYTE_CQL_HOSTS="{{ yb_ycql_hosts }}"
RIBS_YUGABYTE_CQL_PORT="{{ yb_ycql_port }}"
RIBS_YUGABYTE_CQL_KEYSPACE="filecoingw_{{ fgw_node_id | replace('-', '_') }}"
{% if yb_ycql_user | length > 0 %}
RIBS_YUGABYTE_CQL_USER="{{ yb_ycql_user }}"
RIBS_YUGABYTE_CQL_PASS="{{ yb_ycql_pass }}"
{% endif %}

# =============================================================================
# S3 Shared Keyspace (object routing)
# =============================================================================
RIBS_S3_CQL_HOSTS="{{ yb_ycql_hosts }}"
RIBS_S3_CQL_PORT="{{ yb_ycql_port }}"
RIBS_S3_CQL_KEYSPACE="{{ yb_shared_s3_keyspace }}"

# =============================================================================
# S3 API (internal)
# =============================================================================
RIBS_S3API_BINDADDR=":{{ kuri_s3_port }}"
RIBS_S3API_REGION="{{ ribs_s3api_region }}"
RIBS_S3API_AUTH_ENABLED="{{ ribs_s3api_auth_enabled }}"
{% if ribs_s3api_root_access_key_id is defined and ribs_s3api_root_access_key_id | length > 0 %}
RIBS_S3API_ROOT_ACCESS_KEY_ID="{{ ribs_s3api_root_access_key_id }}"
RIBS_S3API_ROOT_SECRET_KEY="{{ ribs_s3api_root_secret_key }}"
{% endif %}

# =============================================================================
# LocalWeb (CAR file staging for storage providers)
# =============================================================================
EXTERNAL_LOCALWEB_PATH="{{ fgw_cardata_path }}"
EXTERNAL_LOCALWEB_URL="{{ external_localweb_url }}"
EXTERNAL_LOCALWEB_BUILTIN_SERVER="{{ external_localweb_builtin_server }}"
EXTERNAL_LOCALWEB_SERVER_PORT="{{ kuri_localweb_port }}"
EXTERNAL_LOCALWEB_SERVER_TLS="{{ external_localweb_server_tls }}"
EXTERNAL_LOCALWEB_MAX_CONCURRENT_UPLOADS_PER_DEAL="{{ external_localweb_max_concurrent_uploads_per_deal }}"

# =============================================================================
# Internal API
# =============================================================================
FGW_INTERNAL_API_BINDADDR=":{{ kuri_internal_api_port }}"

# =============================================================================
# Prometheus Metrics
# =============================================================================
RIBS_PROMETHEUS_PORT="{{ ribs_prometheus_port }}"

# =============================================================================
# Logging
# =============================================================================
RIBS_LOGLEVEL="{{ ribs_loglevel }}"

# =============================================================================
# Repair Workers (data recovery from storage providers)
# =============================================================================
RIBS_REPAIR_WORKERS="{{ ribs_repair_workers }}"
RIBS_REPAIR_STAGING_PATH="{{ ribs_repair_staging_path }}"

# =============================================================================
# Parallel Write Settings
# =============================================================================
{% if ribs_enable_parallel_writes is defined %}
RIBS_ENABLE_PARALLEL_WRITES="{{ ribs_enable_parallel_writes }}"
{% endif %}
{% if ribs_max_parallel_groups is defined %}
RIBS_MAX_PARALLEL_GROUPS="{{ ribs_max_parallel_groups }}"
{% endif %}
{% if ribs_space_reservation_timeout is defined %}
RIBS_SPACE_RESERVATION_TIMEOUT="{{ ribs_space_reservation_timeout }}"
{% endif %}
{% if ribs_drain_timeout is defined %}
RIBS_DRAIN_TIMEOUT="{{ ribs_drain_timeout }}"
{% endif %}

# =============================================================================
# IPFS Path
# =============================================================================
IPFS_PATH="{{ fgw_ipfs_path }}"
